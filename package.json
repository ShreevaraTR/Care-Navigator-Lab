{
  "name": "care-navigator-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Simulation-based training lab for U.S. health insurance Care Navigator work (claims, EOBs, billing, prior auth, CPT/ICD-10, appeals).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "kb:docs": "UPDATE_KB_DOCS=1 vitest run src/content/plan-knowledge",
    "portfolio:docs": "UPDATE_PORTFOLIO_DOCS=1 vitest run src/content/cases/portfolio"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
